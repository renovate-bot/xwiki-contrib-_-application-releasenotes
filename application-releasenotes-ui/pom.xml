<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib.releasenotes</groupId>
    <artifactId>application-releasenotes</artifactId>
    <version>2.7-SNAPSHOT</version>
  </parent>
  <artifactId>application-releasenotes-ui</artifactId>
  <name>Release Notes Application - UI</name>
  <packaging>xar</packaging>
  <description>Manages Release Notes for software products (creation, reports)</description>
  <properties>
    <!-- Name to display by the Extension Manager -->
    <xwiki.extension.name>Release Notes Application</xwiki.extension.name>
    <!-- Extension Manager category -->
    <xwiki.extension.category>application</xwiki.extension.category>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-rendering-macro-velocity</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xwiki.rendering</groupId>
      <artifactId>xwiki-rendering-macro-html</artifactId>
      <version>${rendering.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The {{translation}} macro, which displays the strings of the release note pages and forms. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-localization-macro</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Required for Class Sheet Binding -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-sheet-ui</artifactId>
      <version>${platform.version}</version>
      <type>xar</type>
      <scope>runtime</scope>
    </dependency>
    <!-- The {{liveData}} macro, used to list the release notes and the release changes. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-livedata-macro</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The "liveTable" Live Data source used by those two Live Data instances. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-livedata-livetable</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Provides XWiki.LiveTableResults, the page that the "liveTable" Live Data source renders to get its data. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-livetable-ui</artifactId>
      <version>${platform.version}</version>
      <type>xar</type>
      <scope>runtime</scope>
    </dependency>
    <!-- Provides $services.extension, used by the getChanges macro to compare versions with the extension version
         ordering instead of comparing them as strings. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-extension-script</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Required by wiki macros -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-rendering-wikimacro-store</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The Panels application is an optional dependency since the Release Notes application can work even if it's not
       present but if it's there then it'll register in the Applications Panel. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-panels-ui</artifactId>
      <version>${platform.version}</version>
      <type>xar</type>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <!-- Optional since it's used only by some displayers: Grid, Flow, etc -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-rendering-macro-gallery</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-test-page</artifactId>
      <version>${platform.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Provides templates/macros.vm, whose macros XWiki injects as global Velocity macros. The Screenshots custom
         display calls #attachmentPicker from there, and the page test would otherwise render that call verbatim. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-web-templates</artifactId>
      <version>${platform.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Provides the LiveDataMacroComponentList annotation, needed by the page test rendering a liveData macro. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-livedata-macro</artifactId>
      <version>${platform.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- Provides the WikiMacroFactoryComponentClass annotation, needed by the page tests calling a wiki macro. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-rendering-wikimacro-store</artifactId>
      <version>${platform.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- The XAR packaging uses the XAR plugin and thus we need to define what version to use -->
      <plugin>
        <groupId>org.xwiki.commons</groupId>
        <artifactId>xwiki-commons-tool-xar-plugin</artifactId>
        <version>${commons.version}</version>
        <configuration>
          <visibleTechnicalPages>
            <visibleTechnicalPage>.*/ReleaseNotes/WebHome\.xml</visibleTechnicalPage>
            <visibleTechnicalPage>.*/ReleaseNotes/Data/WebHome\.xml</visibleTechnicalPage>
          </visibleTechnicalPages>
          <entries>
            <entry>
              <document>ReleaseNotes.Code.ReleaseNoteTemplate</document>
              <type>customizable</type>
            </entry>
            <entry>
              <document>ReleaseNotes.WebHome</document>
              <type>customizable</type>
            </entry>
            <!-- ReleaseNotes.Code.ReleaseNotesConfig is deliberately not declared here. Besides the configuration
                 values set by the administrator, it carries the XWiki.ConfigurableClass xobject that registers the
                 application in the Administration, and that xobject has to be on that page since ConfigurableClass
                 looks the configuration xobject up on its own document. It therefore needs the default entry type,
                 whose 3-way merge brings such structural changes to already installed wikis while keeping the values
                 the administrator changed. An entry type that skips the upgrade would freeze the page instead. -->
          </entries>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
