<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib.releasenotes</groupId>
    <artifactId>application-releasenotes</artifactId>
    <version>2.7-SNAPSHOT</version>
  </parent>
  <artifactId>application-releasenotes-api</artifactId>
  <name>Release Notes Application - API</name>
  <packaging>jar</packaging>
  <description>Java API to create and read the release notes and the changes of a wiki</description>
  <properties>
    <!-- Name to display by the Extension Manager -->
    <xwiki.extension.name>Release Notes Application - API</xwiki.extension.name>
    <!-- The instructions that are not covered are the ones wrapping a store or a query failure, which the test
         store does not fail on. -->
    <xwiki.jacoco.instructionRatio>0.96</xwiki.jacoco.instructionRatio>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-component-api</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <!-- The @Unstable annotation the new API is marked with. -->
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-stability</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <!-- The ScriptService role, and the bean properties the converters populate. -->
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-script</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-properties</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <!-- The documents and the xobjects the release notes and the changes are made of. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-oldcore</artifactId>
      <version>${platform.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- The version ordering the version filters of a change search are compared with. -->
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-extension-api</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <!-- The pages of a release note are looked up with a query. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-query-manager</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Creating a release note or a change checks the edit right of both the user and the author. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-security-authorization-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- The title a new release note is given is a translated one. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-localization-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-oldcore</artifactId>
      <version>${platform.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-tool-test-component</artifactId>
      <version>${commons.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Routes the Log4j 2 API, which the oldcore test setup pulls in, to SLF4J. Without it, Log4j writes to the
         console that it found no logging provider, which the console-capturing test listener fails the build on. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-to-slf4j</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The Expression Language implementation the bean validation provider interpolates its messages with, which an
         application server brings at runtime. Without it, populating a bean writes to the console that validation is
         off, which the console-capturing test listener fails the build on. -->
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
